    {
      "parameters": {
        "jsCode": "const goldData = $input.first().json;\nconst lineEvent = $('Webhook').first().json.body.events[0];\n\nconst response = goldData.response;\nconst message = `📊 ราคาทองวันนี้\n━━━━━━━━━━━━━━━\n📅 ${response.update_date} ${response.update_time}\n\n🏆 ทองคำแท่ง 96.5%\n   💰 ขายออก: ${response.price.gold_bar.sell} บาท\n   💵 รับซื้อ: ${response.price.gold_bar.buy} บาท\n\n💍 ทองรูปพรรณ 96.5%\n   💰 ขายออก: ${response.price.gold.sell} บาท\n   💵 รับซื้อ: ${response.price.gold.buy} บาท\n\n📌 ข้อมูลจากสมาคมค้าทองคำ`;\n\nreturn [{\n  json: {\n    replyToken: lineEvent.replyToken,\n    messages: [{\n      type: \"text\",\n      text: message\n    }]\n  }\n}];"
      },
